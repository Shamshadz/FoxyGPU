# Copy this to your project root as `.foxygpuignore` to add extra excludes.
# One ignore pattern per line. A name matches any component (`.venv`), while a
# slash-delimited path matches relative to the project root (`models/gpt2/`).
# Shell-style component globs work too: `*.pth` excludes checkpoints at any
# depth. Everything below is already excluded by default.
.git
node_modules
__pycache__
venv
.venv
.foxygpu
.mypy_cache
.pytest_cache
dist
build
